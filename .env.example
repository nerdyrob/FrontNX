HOST=0.0.0.0
PORT=3001

# Use NUXT_PUBLIC_ prefix for values that should be configurable at runtime.
# These use Nuxt's runtime config mechanism and are NOT baked into the build.
# Change them in .env or pass as environment variables when starting the server.
NUXT_PUBLIC_LLM_SERVER_BASE_URL=http://your-server:1234
NUXT_PUBLIC_LLM_SERVER_NAME='Your Server Name'
NUXT_PUBLIC_CHAT_REQUEST_TIMEOUT_MS=900000

# Optional: Extra instructions appended to the built-in system prompt.
# NUXT_PUBLIC_LLM_SYSTEM_PROMPT="You are a coding expert. Be concise."

# Optional: Size / body limits (bytes).  Defaults shown.
# NUXT_PUBLIC_MAX_IMAGE_DISPLAY_BYTES=10485760    # 10 MB — Base64Image rendering cap
# NUXT_PUBLIC_MAX_SESSION_FILE_BYTES=26214400     # 25 MB — session file write cap
# NUXT_PUBLIC_MAX_PROXY_BODY_BYTES=10485760       # 10 MB — LM proxy request body cap

# Optional: API key for server-to-server auth (server-side only, not exposed to client).
# NUXT_API_KEY=your-secret-key
