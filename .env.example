HOST=0.0.0.0
PORT=3001
LLM_SERVER_BASE_URL=http://your-server:1234
LLM_SERVER_NAME='Your Server Name'
CHAT_REQUEST_TIMEOUT_MS=900000

# Optional: Extra instructions appended to the built-in system prompt (which defines the
# rendering tooling: math, code fences, tables, charts, etc.). Your custom text is prepended
# so you can set the assistant's personality or add rules while keeping the format tools.
# If left empty, only the built-in prompt is used.
# Example:
# LLM_SYSTEM_PROMPT="You are a coding expert. Be concise."

# Optional: API key for server-to-server auth. All API routes require
# `Authorization: Bearer <API_KEY>` header when this is set.
# API_KEY=your-secret-key
